# Copia este fichero a .env y rellena los tres valores.
# El corrector funciona con cualquier endpoint compatible con OpenAI.

# --- Opción A: OpenRouter (una clave, muchos modelos; hay modelos gratuitos) ---
CORRECTOR_BASE_URL=https://openrouter.ai/api/v1
CORRECTOR_MODEL=google/gemini-2.5-flash-lite
CORRECTOR_API_KEY=

# --- Opción B: Google AI Studio (Gemini con clave propia) ---
# CORRECTOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CORRECTOR_MODEL=gemini-2.5-flash-lite
# CORRECTOR_API_KEY=

# --- Opción C: Ollama local (sin clave, sin coste, sin enviar nada fuera) ---
# CORRECTOR_BASE_URL=http://localhost:11434/v1
# CORRECTOR_MODEL=qwen3:14b
# CORRECTOR_API_KEY=ollama

# --- Opción D: OpenCode Go (pasarela con sesión) ---
# CORRECTOR_BASE_URL=https://opencode.ai/inference/go/openai/v1
# CORRECTOR_MODEL=deepseek-v4.1-flash
# CORRECTOR_EXTRA_HEADER=x-opencode-session: 00000000-0000-0000-0000-000000000000

# Segundos de espera por llamada
CORRECTOR_TIMEOUT=120
